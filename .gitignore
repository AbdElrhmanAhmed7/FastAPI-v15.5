# Repository-root ignores (per-service ignores live next to each service).

# Reproducible payload-capture dumps – see reference/scratch/README.md
reference/scratch/payloads*.json
reference/scratch/*.db

# Local environment / editor noise
.env
.DS_Store
.vscode/
.idea/

# Generated delivery snapshot – regenerated by tools/make_release.sh (see releases/README.md)
releases/*.zip

# Workspace noise. The git root deliberately doubles as the delivery workspace root
# (MIGRATION.md 13): uploading the workspace contents then lands the project at the
# git root, which is what GitHub needs. These platform directories must never enter
# the tree, so they are ignored rather than left to be noticed by hand.
/uploads/
/.arena/
